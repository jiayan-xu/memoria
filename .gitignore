# Auto-generated admin key (P0-2: never commit)
admin_key.secret
# 通用密钥文件（P0-3 强化：与 agent-core 对齐，避免任何 *.key 误提交）
*.key

# Local secrets (P0: never commit real .env)
.env
*.env.local
*.env.*.local
# env 备份/历史快照（含真实密钥，禁止提交）
.env.bak.*
.env.*.bak*
# 通用备份/快照文件（*.bak* / *.bak_*，含密钥历史不得入库）
*.bak*
# but keep the documented example
!.env.example

# Single-writer lock file (P0-4)
*.pid

# Logs
*.log

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/
*.swp

